{
  "id": null,
  "title": "Microservicio Clientes - Estado y Métricas",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Disponibilidad (UP)",
      "id": 1,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"ms-clientes\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requests por segundo",
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"ms-clientes\"}[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia promedio (s)",
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{job=\"ms-clientes\"}[1m]) / rate(http_server_requests_seconds_count{job=\"ms-clientes\"}[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errores 4xx / 5xx",
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"ms-clientes\", status=~\"4..|5..\"}[1m])) by (status)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uso de memoria JVM (heap)",
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"ms-clientes\", area=\"heap\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
